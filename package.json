{
  "name": "dsh-pairing-gate",
  "version": "0.7.2",
  "type": "module",
  "main": "lib/index.js",
  "description": "Front-door HTTPS device-pairing gateway for DeepSeek Harness: TOTP-authorised QR device pairing, username/password login, sliding sessions and a reverse proxy with WebSocket tunnelling to a local dsh.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "auth",
    "gateway",
    "remote"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chjy090/dsh-pairing-gate.git"
  },
  "homepage": "https://github.com/chjy090/dsh-pairing-gate#readme",
  "bugs": {
    "url": "https://github.com/chjy090/dsh-pairing-gate/issues"
  },
  "license": "MIT",
  "private": true,
  "files": [
    "lib",
    "locales",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "bash tests/e2e-standalone.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
