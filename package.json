{
  "name": "dsh-auth-gate",
  "version": "0.6.2",
  "type": "module",
  "main": "lib/index.js",
  "description": "Front-door HTTPS auth gateway for DeepSeek Harness: TOTP-authorised QR device pairing + username/password login, reverse-proxying to a local dsh.",
  "license": "MIT",
  "private": true,
  "files": [
    "lib",
    "locales",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "e2e": "bash tests/e2e-standalone.sh"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "manifestVersion": 1,
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  }
}
